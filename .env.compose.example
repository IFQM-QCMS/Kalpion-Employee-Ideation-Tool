# Credentials for the kalpion-db container.
#
# Copy to `.env` beside docker-compose.yml on the VPS (/opt/ifqm-kalpion/.env).
# Docker Compose reads that file automatically; it is gitignored, and these
# values must never be committed.
#
# MARIADB_PASSWORD has to match MASTER_DB_PASS and APP_DB_PASS in
# backend/.env, or the API cannot log in to its own database.
#
# Generate each one fresh:
#   openssl rand -hex 24
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
