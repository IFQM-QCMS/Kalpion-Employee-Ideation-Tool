# IFQM Backend (Kalpion) - environment configuration.
# Copy to .env and fill in real values. Never commit the real .env.
#
# In production the server refuses to start if JWT_SECRET is missing or under 32
# characters, the DB password is empty, the DB user is root, or CORS_ORIGIN
# still mentions localhost. Read the banner it prints and fix what it names.

# ── HTTP ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Exact origins of the React frontend, comma-separated, no trailing slash.
# This is an exact-match allowlist, not a pattern.
CORS_ORIGIN=https://ideas.yourcompany.com

# Public URL of the frontend. Used to build the link in password-reset emails.
FRONTEND_BASE_URL=https://ideas.yourcompany.com

# Redirect http->https and send HSTS. Defaults to true when NODE_ENV=production.
FORCE_HTTPS=true

# Proxy hops to trust when working out the caller's IP. 1 is right behind a
# single reverse proxy; use true only where the edge rewrites X-Forwarded-For.
TRUST_PROXY=1

# Requests per IP per 15 min across the whole API.
GLOBAL_RATE_LIMIT=600

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs every session token. Anyone holding it can forge a token for any user in
# any tenant. Minimum 32 characters, different in every environment. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Session lifetime in seconds (28800 = 8h).
JWT_EXPIRES_IN=28800
MIN_PASSWORD_LENGTH=12

# Failed logins per IP per 15 min before throttling. The per-account lockout
# (5 strikes, 15 min) is separate and always on.
AUTH_RATE_LIMIT=30

# ── Database ──────────────────────────────────────────────────────────────────
# The app reaches every tenant schema with this one account. Do not use root:
# create a user restricted to the ifqm_% schemas.
APP_DB_USER=ifqm_app
APP_DB_PASS=

# Master registry: which organisations exist and which schema each lives in.
MASTER_DB_HOST=localhost
MASTER_DB_NAME=ifqm_master
MASTER_DB_USER=ifqm_app
MASTER_DB_PASS=

# TLS. A MySQL on the same host needs none of this; a managed service refuses
# plaintext, so set DB_SSL=true there.
#
# Azure Database for MySQL: DB_SSL=true and leave DB_SSL_CA BLANK. Azure's
# certificates chain to a public root that Node already trusts, so the
# connection is verified against the built-in store with nothing to paste and
# nothing to rotate when the server certificate is renewed. Port stays 3306 and
# the username is the plain admin name, with no @servername suffix.
#
# Set DB_SSL_CA only for a provider that issues its own private CA, pasted in
# full. It accepts real newlines or the two-character sequence \n.
#
# DB_SSL_INSECURE=true encrypts without verifying the server. It is the wrong
# answer to a certificate error in almost every case - fix the chain instead.
DB_PORT=3306
DB_SSL=false
DB_SSL_CA=
DB_SSL_INSECURE=

# Connections per schema, and how many tenant pools stay open at once.
# (tenants + 1) x DB_POOL_SIZE must stay under the server's max_connections.
DB_POOL_SIZE=10
DB_MAX_POOLS=10

# Single-tenant fallback, used only when there is no master registry (dev).
FALLBACK_DB_HOST=localhost
FALLBACK_DB_NAME=ifqm_ideation
FALLBACK_DB_USER=ifqm_app
FALLBACK_DB_PASS=

# ── Platform mail sender ──────────────────────────────────────────────────────
# The account the platform sends from when a customer has no SMTP of its own:
# one-time sign-in codes, password resets, registration acknowledgements, the
# new-application notice to platform admins. Set here and nowhere else - there
# is no screen for it in the console. Per-tenant SMTP still takes precedence.
#
# Defaults below are ZeptoMail. PLATFORM_MAIL_FROM must be on a domain verified
# with the provider or every message is rejected.
PLATFORM_SMTP_HOST=smtp.zeptomail.in
PLATFORM_SMTP_PORT=465
PLATFORM_SMTP_USER=emailappsmtp.xxxxxxxxxxxxxxxx
PLATFORM_SMTP_PASS=
PLATFORM_MAIL_FROM=noreply@your-domain.example
PLATFORM_MAIL_FROM_NAME=IFQM

# auto | api | smtp. 'auto' tries SMTP and falls back to the provider's HTTPS
# API. Use 'api' on a host that blocks outbound SMTP, where the port hangs
# rather than refusing - on 'auto' the first send waits out the full timeout.
PLATFORM_MAIL_TRANSPORT=auto

# The provider's HTTP API token - a different credential from the SMTP password
# above. Required whenever the API route may be used. Quote it: the token
# contains / + and =.
PLATFORM_MAIL_API_KEY=

# Offer sign-in by one-time code. Overrides the stored platform setting; leave
# blank to let the stored setting decide.
OTP_ENABLED=true

# ── SMS one-time codes ────────────────────────────────────────────────────────
# Codes by SMS for sign-in, password reset, registration and verifying a changed
# number. Env-only, like the mail sender.
#
# provider: kaleyra | jio_dlt | msg91 | twilio | log. 'log' prints the code to
# the server log and is refused in production.
SMS_PROVIDER=kaleyra
SMS_ENDPOINT=https://api.kaleyra.io

# Kaleyra puts the account id in the URL path, not a header. Missing or wrong,
# every send answers 401 "Incorrect SID or API key", which reads as a bad key.
SMS_SID=
SMS_API_KEY=

# Six characters. The registration reads IFQMID-T; the -T is Jio's category
# annotation, not part of the header. Either spelling is accepted here and six
# characters go on the wire.
SMS_SENDER_ID=IFQMID
SMS_PE_ID=

# DLT content templates: leave blank.
#
# The registered ids and their approved wording live together in
# backend/src/config/smsTemplates.js, because the carrier checks one against the
# other and an id in a .env with the sentence in a code file is how the two
# drift apart. A body that no longer matches its id is accepted by the gateway
# and then dropped by the carrier, with no error anywhere.
#
# To override one for a deployment you must set both halves, or it is ignored
# with a warning at boot:
#   SMS_TEMPLATE_LOGIN / SMS_TEXT_LOGIN
#   SMS_TEMPLATE_RESET / SMS_TEXT_RESET
#   SMS_TEMPLATE_ACTIVATION / SMS_TEXT_ACTIVATION
#   SMS_TEMPLATE_PHONE_CHANGED / SMS_TEXT_PHONE_CHANGED
# Always quote SMS_TEXT_*: dotenv reads an unquoted # as a comment, and the
# placeholder starts with one, so {#var#} unquoted truncates to "{".

# ── Gamification points ───────────────────────────────────────────────────────
POINTS_SUBMIT=10
POINTS_APPROVED=25
POINTS_IMPLEMENTED=65

# ── Uploads ───────────────────────────────────────────────────────────────────
# A ceiling; an organisation may set a lower limit of its own. backend/uploads/
# must be writable and on storage that survives a restart.
MAX_FILE_MB=10

# ── Background jobs ───────────────────────────────────────────────────────────
# The email queue drain, approval-chain repair, retention purge, billing sweep
# and registration-notice retry. Set to 0 on every instance but one; two
# instances would drain the same queue.
RUN_BACKGROUND_JOBS=1
EMAIL_QUEUE_INTERVAL_MS=60000

# Scheduled mysqldump. Left unset means no scheduled backup; use cron, or the
# provider's own backups, instead.
BACKUP_EVERY_HOURS=
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_UPLOADS=0
MYSQLDUMP=

# ── Logging ───────────────────────────────────────────────────────────────────
# Set LOG_TO_FILE=0 on a host with an ephemeral disk.
LOG_TO_FILE=1
LOG_DIR=

# ── AI scoring (optional) ─────────────────────────────────────────────────────
# Blank uses the built-in heuristic scorer and spends nothing.
# AI_PROVIDER = openai | gemini | (blank)
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── QCMS integration ──────────────────────────────────────────────────────────
# Default base URL for pushing approved ideas. An org admin can override it per
# tenant in Admin -> API & Integration.
QCMS_BASE_URL=http://localhost:5000/api/v1/integrations
