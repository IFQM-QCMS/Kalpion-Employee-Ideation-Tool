# ─────────────────────────────────────────────────────────────────────────────
#  IFQM Backend — environment configuration
#
#  Copy to `.env` and fill in real values. NEVER commit the real .env.
#
#  In production the server REFUSES TO START if the secrets below are missing,
#  left at their example values, or obviously unsafe (empty DB password, root DB
#  user, localhost CORS). That is deliberate — a silently-insecure default is
#  worse than a crash. See docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=4000

# Set to `production` on the real server. Enables the strict config checks,
# HSTS, HTTPS redirection, and fail-closed tenant resolution.
NODE_ENV=production

# Exact origin(s) of the React frontend, comma-separated, no trailing slash.
# Must not be localhost in production.
CORS_ORIGIN=https://ideas.yourcompany.com

# Public URL of the frontend — used to build the link inside password-reset
# emails. Must be https in production, or the reset token travels in the clear.
FRONTEND_BASE_URL=https://ideas.yourcompany.com

# Redirect http→https and send HSTS. Defaults to true when NODE_ENV=production.
FORCE_HTTPS=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# The key every session token is signed with. Anyone who knows it can mint a
# token for ANY user in ANY tenant, including an admin — treat it like a root
# password. Minimum 32 chars. Generate a fresh one per environment:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating it logs everyone out — that is the "revoke all sessions" lever.
JWT_SECRET=

# Session lifetime in seconds (28800 = 8h).
JWT_EXPIRES_IN=28800

# Minimum length for any password the app accepts.
MIN_PASSWORD_LENGTH=12

# Failed logins per IP per 15 min before throttling. The per-account lockout
# (5 strikes → 15 min) is separate and always on.
AUTH_RATE_LIMIT=30

# ── Database ─────────────────────────────────────────────────────────────────
# The app reaches EVERY tenant schema with this one account. Do not use root:
# create a least-privilege user restricted to the `ifqm_%` schemas — the exact
# GRANT statements are in docs/DEPLOYMENT.md.
APP_DB_USER=ifqm_app
APP_DB_PASS=

# Port + TLS for every MySQL connection. A local XAMPP MySQL needs neither;
# a managed provider (Aiven, PlanetScale, …) listens on its own port and
# refuses plaintext clients, so set DB_PORT and DB_SSL=true there.
# DB_SSL_CA is the provider's CA certificate pasted in full (single line with
# \n is fine) — without it the link is encrypted but the server is unverified.
DB_PORT=3306
DB_SSL=false
DB_SSL_CA=

# Connections per schema. (tenants + 1) × DB_POOL_SIZE must stay below the
# server's max_connections — small free-tier databases allow very few, so
# drop this to 2-3 there.
DB_POOL_SIZE=10

# Master registry: which organisations exist, and which schema each lives in.
MASTER_DB_HOST=localhost
MASTER_DB_NAME=ifqm_master
MASTER_DB_USER=ifqm_app
MASTER_DB_PASS=

# Single-tenant fallback, used only when there is no master registry (dev).
FALLBACK_DB_HOST=localhost
FALLBACK_DB_NAME=ifqm_ideation

# ── Gamification points ──────────────────────────────────────────────────────
POINTS_SUBMIT=10
POINTS_APPROVED=25
POINTS_IMPLEMENTED=65

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_FILE_MB=10

# ── AI scoring (optional) ────────────────────────────────────────────────────
# Leave AI_PROVIDER blank to use the built-in heuristic scorer and spend nothing.
# AI_PROVIDER = openai | gemini | (blank)
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── QCMS integration ─────────────────────────────────────────────────────────
# Default base URL of the QCMS Integration API (approved ideas are pushed here).
# An org admin can override it per tenant in Admin → API & Integration.
# Local dev: http://localhost:5000/api/v1/integrations · Prod: https://api.qcms.com/v1
QCMS_BASE_URL=http://localhost:5000/api/v1/integrations

# ── Platform mail sender ─────────────────────────────────────────────────────
# The account the platform itself sends from, used whenever there is no customer
# SMTP to use: one-time sign-in codes, password-reset links, registration
# acknowledgements, billing notices.
#
# Deliberately configured here and nowhere else. It is one account belonging to
# the vendor, set once per deployment, and it has no screen in the platform
# console: a live credential in a database plus a form that can break sign-in
# for every customer is not a trade worth making. Per-tenant SMTP is unaffected
# and still takes precedence wherever a customer has filled it in.
#
# Any SMTP server works. These defaults are for ZeptoMail (Zoho):
#   Host  smtp.zeptomail.in   (.com for the non-India region — a token from one
#                              region is rejected by the other)
#   Port  587 STARTTLS, or 465 for implicit TLS
#   User  the "emailappsmtp.…" username from the Mail Agent's SMTP tab
#   From  must be on a domain VERIFIED in ZeptoMail, or everything is rejected
PLATFORM_SMTP_HOST=smtp.zeptomail.in
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=emailappsmtp.xxxxxxxxxxxxxxxx
PLATFORM_SMTP_PASS=
PLATFORM_MAIL_FROM=noreply@your-domain.example
PLATFORM_MAIL_FROM_NAME=IFQM

# Offer sign-in by one-time code on the login screen. Overrides the stored
# platform setting when set, so a deployment that has the sender above can turn
# the feature on without anybody opening the console. Leave blank to let the
# stored setting decide.
OTP_ENABLED=
