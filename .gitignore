# ── Secrets ────────────────────────────────────────────────────────
# Never commit a real .env — it holds the JWT signing key, the DB password and
# the SMTP/AI credentials. Commit .env.example instead.
.env
.env.*
!.env.example
*.pem
*.key

# ── Dependencies ───────────────────────────────────────────────────
node_modules/

# ── Build output ───────────────────────────────────────────────────
dist/
build/

# ── Runtime data ───────────────────────────────────────────────────
# Employee-uploaded attachments: real user data. Belongs in backups, not in
# source control.
backend/uploads/*
!backend/uploads/.gitkeep

# Python bytecode from the document generators in docs/
__pycache__/
*.pyc

# ── Logs / OS / editor noise ───────────────────────────────────────
*.log
npm-debug.log*
logs/
.DS_Store
Thumbs.db
.vscode/
.idea/

.gstack/

# Database backups — data, never source
backend/backups/

# Word's lock file for an open .docx — created beside the document, not content
~$*.docx
# Vite writes this while resolving its config; regenerated every run
frontend/vite.config.js.timestamp-*.mjs

# Slide PNGs exported from PowerPoint to eyeball a build — regenerated on demand
Customer Presentation/preview/
